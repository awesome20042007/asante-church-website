DJANGO_SECRET_KEY=johndoyouknowthesecretkey12345678901234567890
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_HTTPS=False

# Extra live-site switches (leave these off on your own computer)
DJANGO_SSL_REDIRECT=False
DJANGO_PROXY_SSL_HEADER=False
DJANGO_CSRF_TRUSTED_ORIGINS=

# Who receives contact-form emails (leave empty to turn email off)
DJANGO_CONTACT_NOTIFY_EMAIL=
DJANGO_DEFAULT_FROM_EMAIL=

# Real email sending (leave DJANGO_EMAIL_HOST empty to just print emails in the terminal)
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True